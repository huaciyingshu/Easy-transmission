set(header "#pragma once\n\n#include <string_view>\n\nnamespace assets {\n")

function(embed name filename)
    file(READ "${PUBLIC_DIR}/${filename}" hex HEX)
    string(LENGTH "${hex}" hex_size)
    math(EXPR byte_count "${hex_size} / 2")
    string(APPEND header "namespace detail {\ninline constexpr char ${name}Bytes[] =\n")
    if(hex_size EQUAL 0)
        string(APPEND header "    \"\"\n")
    endif()
    set(offset 0)
    while(offset LESS hex_size)
        string(SUBSTRING "${hex}" ${offset} 512 chunk)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "\\\\x\\1" chunk "${chunk}")
        string(APPEND header "    \"${chunk}\"\n")
        math(EXPR offset "${offset} + 512")
    endwhile()
    string(APPEND header ";\n}\ninline constexpr std::string_view ${name}{detail::${name}Bytes, ${byte_count}};\n\n")
    set(header "${header}" PARENT_SCOPE)
endfunction()

embed(index index.html)
embed(script app.js)
embed(style style.css)
string(APPEND header "} // namespace assets\n")
file(WRITE "${OUTPUT}" "${header}")
